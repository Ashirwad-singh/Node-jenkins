{
  "name": "node-jenkins",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "build": "rm -rf dist && esbuild src/server.js --bundle --platform=node --packages=external --outfile=dist/server.js"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
